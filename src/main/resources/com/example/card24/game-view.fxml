<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.card24.controller.GameController"
      fx:id="rootBox"
      spacing="18"
      styleClass="root-container">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox fx:id="topRow" spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="findSolutionButton" text="Find a Solution" onAction="#onFindSolution"/>
        <TextField fx:id="solutionField" prefWidth="420" promptText="Found solution appears here" editable="false"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
    </HBox>

    <HBox fx:id="middleRow" spacing="16" alignment="CENTER">
        <ImageView fx:id="card1" fitWidth="100" fitHeight="145" preserveRatio="false" smooth="true" styleClass="card-image"/>
        <ImageView fx:id="card2" fitWidth="100" fitHeight="145" preserveRatio="false" smooth="true" styleClass="card-image"/>
        <ImageView fx:id="card3" fitWidth="100" fitHeight="145" preserveRatio="false" smooth="true" styleClass="card-image"/>
        <ImageView fx:id="card4" fitWidth="100" fitHeight="145" preserveRatio="false" smooth="true" styleClass="card-image"/>
    </HBox>

    <HBox fx:id="bottomRow" spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="expressionLabel" text="Enter an expression:"/>
        <TextField fx:id="expressionField" prefWidth="360" promptText="Example: (3 + 3) * (4 - 2)"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="verifyButton" text="Verify" onAction="#onVerify"/>
    </HBox>
</VBox>
